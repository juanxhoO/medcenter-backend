# =================================================================
# Medcenter Docker Environment Configuration
# =================================================================

# Application Settings
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database
POSTGRES_DB=medcenter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=secret

# Redis Commander Web UI
REDIS_COMMANDER_PORT=8081

# Mailhog (Email testing)
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1026

# Data Seeding
APP_SEEDING_ENABLED=true
APP_SEEDING_ADMIN_EMAIL=admin@medcenter.com
APP_SEEDING_ADMIN_PASSWORD=Admin123!

